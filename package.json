{
  "name": "pi-martix-ui",
  "productName": "ZION",
  "version": "0.2.0",
  "description": "ZION — 黑客帝国风 Windows 桌面 Agent（pi 为底座）",
  "license": "MIT",
  "type": "module",
  "main": "src/main/main.mjs",
  "scripts": {
    "dev": "concurrently -k \"vite --config vite.config.mjs\" \"wait-on tcp:127.0.0.1:5173 && electron . --dev\"",
    "build:renderer": "vite build --config vite.config.mjs",
    "start": "electron .",
    "pack": "npm run build:renderer && electron-builder --dir",
    "dist": "npm run build:renderer && electron-builder"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.1.2",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.1.5",
    "wait-on": "^8.0.1"
  },
  "allowScripts": {
    "electron@43.3.0": true
  }
}
